# Installs (reinstall with npm ci / uv sync)
node_modules/
.venv/
__pycache__/
*.pyc

# Footage, renders and per-job work: big, personal, regenerable
projects/
jobs/
raw/*
!raw/.gitkeep
transcript/*
!transcript/.gitkeep
vendor/
renders/
engines/split-screen/inputs/*
!engines/split-screen/inputs/PUT_YOUR_VIDEO_HERE.txt
engines/split-screen/public/demo/source.*
*.mp4
*.mov
*.webm
*.m4a
*.wav.tmp
cut.mp4

# Scraped research reports (other creators' posts and signed image links)
engines/content-os/research/*.html
engines/legacy-editor/projects/

# Secrets and machine-specific settings
.env
.env.*
!.env.example
.mcp.json
*.pem
.claude/settings.local.json

# OS and editor clutter
.DS_Store
Thumbs.db
desktop.ini
.cache*/
*.log

# Faceless engine: installs, caches, the user's sprite images, voiceovers and renders
engines/faceless/engine/.cache/
engines/faceless/engine/bin/
engines/faceless/sprite/raw/*
!engines/faceless/sprite/raw/README.md
engines/faceless/voiceovers/*
!engines/faceless/voiceovers/README.md
engines/faceless/videos/*
!engines/faceless/videos/README.md
engines/faceless/sprite/poses/
engines/faceless/sprite/sprite.json
engines/faceless/sprite/preview.png

# Brand Motion engine: its Python env and the ElevenLabs key it saves
engines/brand-motion/.venv/
engines/brand-motion/.elevenlabs_key

# Video FX engine: installs, matting model (GPL-3.0 weights, downloaded), caches, renders
engines/video-fx/engine/.venv/
engines/video-fx/engine/models/
engines/video-fx/engine/.cache/
engines/video-fx/engine/jobs/
engines/video-fx/engine/out/
