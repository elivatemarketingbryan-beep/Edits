{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:split-screen-editor:reference-annotation:v1",
  "title": "Reference annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "source", "inspection", "observations", "principles", "unknowns"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["observed", "illustrative"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "creator", "topic", "publishedDate", "durationSeconds", "dimensions", "mediaBundled"],
      "properties": {
        "url": {"type": ["string", "null"]},
        "creator": {"type": ["string", "null"]},
        "topic": {"type": "string"},
        "publishedDate": {"type": ["string", "null"]},
        "durationSeconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "dimensions": {"type": ["object", "null"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "required": ["width", "height"], "additionalProperties": false},
        "mediaBundled": {"type": "boolean"}
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "method", "continuousReview", "audioReviewed", "coverageNote"],
      "properties": {
        "date": {"type": "string"},
        "method": {"type": "string"},
        "continuousReview": {"type": "boolean"},
        "audioReviewed": {"type": "boolean"},
        "coverageNote": {"type": "string"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atSeconds", "timingMeaning", "layout", "visibleEvidence", "relationships"],
        "properties": {
          "atSeconds": {"type": ["number", "null"], "minimum": 0},
          "timingMeaning": {"enum": ["approximate_observation_point", "verified_boundary", "untimed", "illustrative"]},
          "layout": {"type": "string"},
          "visibleEvidence": {"type": "string"},
          "relationships": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "principles": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
