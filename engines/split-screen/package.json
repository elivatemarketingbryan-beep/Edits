{
  "name": "split-screen-editor",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, agent-directed short-form video editing kit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "editor": "node scripts/editor.mjs",
    "doctor": "node scripts/editor.mjs doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/create-demo.mjs",
    "demo:render": "node scripts/editor.mjs render examples/demo/plan.json",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.1": true
  }
}
