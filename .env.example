# Copy this file to .env (git-ignored) and fill it in. The studio reads it on start.

# ---- Instagram (Post to Instagram button) ----
# A Business or Creator account connected to a Meta app.
# Instagram Login: token scopes instagram_business_basic, instagram_business_content_publish,
#                  instagram_business_manage_insights. Host graph.instagram.com.
# Facebook Login:  token scopes instagram_basic, instagram_content_publish, instagram_manage_insights,
#                  pages_show_list, pages_read_engagement. Host graph.facebook.com.
# Use a long-lived token (60 days); refresh it before it expires.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0

# ---- Google Sheets (reel log + weekly stats) ----
# A Google Cloud service account with the Sheets API enabled. Download its JSON key, save it
# somewhere private (e.g. C:\Users\you\secrets\studio-sheets.json), and share the sheet with the
# key's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=
SHEET_TAB=Reels
